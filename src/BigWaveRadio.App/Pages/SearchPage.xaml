<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BigWaveRadio.App.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BigWaveRadio.App.Controls"
    xmlns:converters="using:BigWaveRadio.App.Converters">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Margin="28,20,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <AutoSuggestBox
            x:Name="QueryBox"
            Grid.Row="0"
            PlaceholderText="Search stations by name…"
            QueryIcon="Find"
            QuerySubmitted="QueryBox_QuerySubmitted"
            Width="400"
            HorizontalAlignment="Left"
            Margin="0,0,0,12" />

        <TextBlock
            Grid.Row="1"
            Text="Type a station name and press Enter to search the whole directory."
            Style="{ThemeResource BodyTextBlockStyle}"
            Opacity="0.6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center"
            MaxWidth="360"
            Visibility="{x:Bind VM.HasSearched, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

        <controls:StationGridView
            Grid.Row="1"
            Items="{x:Bind VM.Stations, Mode=OneWay}"
            IsLoading="{x:Bind VM.IsLoading, Mode=OneWay}"
            EmptyText="No stations match your search."
            PlayRequested="StationGrid_PlayRequested" />
    </Grid>
</Page>
