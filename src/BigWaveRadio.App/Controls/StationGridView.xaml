<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BigWaveRadio.App.Controls.StationGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BigWaveRadio.App.Converters"
    xmlns:vm="using:BigWaveRadio.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="StationCardTemplate" x:DataType="vm:StationItem">
            <Button
                Click="Card_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ToolTipService.ToolTip="{x:Bind Station.Name}"
                AutomationProperties.Name="{x:Bind Station.Name}"
                Tag="{x:Bind}">
                <Grid Height="92" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <SymbolIcon Symbol="Play" Foreground="White" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Station.Name}"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            Text="{x:Bind Station.MetaLine}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                        <TextBlock
                            Text="{x:Bind Station.QualityLine}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="2"
                        IsChecked="{x:Bind IsInLibrary, Mode=OneWay}"
                        Click="Star_Click"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Save to My Library">
                        <SymbolIcon Symbol="Favorite" />
                    </ToggleButton>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsRepeater
                x:Name="Repeater"
                ItemsSource="{x:Bind Items, Mode=OneWay}"
                ItemTemplate="{StaticResource StationCardTemplate}"
                HorizontalAlignment="Stretch">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="300"
                        MinItemHeight="108"
                        ItemsStretch="Fill"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock
            Text="{x:Bind EmptyText, Mode=OneWay}"
            Style="{ThemeResource BodyTextBlockStyle}"
            Opacity="0.6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center"
            MaxWidth="360"
            Visibility="{x:Bind ShowEmptyState, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

        <!-- Loading state -->
        <ProgressRing
            IsActive="{x:Bind IsLoading, Mode=OneWay}"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
