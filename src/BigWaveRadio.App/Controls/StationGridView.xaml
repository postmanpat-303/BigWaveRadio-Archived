<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BigWaveRadio.App.Controls.StationGridView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BigWaveRadio.App.Converters"
    xmlns:controls="using:BigWaveRadio.App.Controls"
    xmlns:vm="using:BigWaveRadio.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="StationCardTemplate" x:DataType="vm:StationItem">
            <!-- The star is a sibling of the play area, not nested inside the
                 card Button, so its clicks are never swallowed by the parent. -->
            <Grid
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ToolTipService.ToolTip="{x:Bind Station.Name}"
                PointerEntered="Card_PointerEntered"
                PointerExited="Card_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Realtime spectrum while this station is the one playing -->
                <controls:SpectrumBars
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Stretch"
                    IsActive="{x:Bind IsPlaying, Mode=OneWay}"
                    IsHitTestVisible="False"
                    Opacity="0.35" />

                <Border
                    x:Name="HoverFill"
                    Grid.ColumnSpan="2"
                    CornerRadius="7"
                    IsHitTestVisible="False"
                    Background="{ThemeResource ControlFillColorTertiaryBrush}"
                    Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </Border.OpacityTransition>
                </Border>

                <Button
                    Grid.Column="0"
                    Click="Card_Click"
                    PointerEntered="Card_PointerEntered"
                    PointerExited="Card_PointerExited"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="{x:Bind Station.Name}"
                    Tag="{x:Bind}">
                    <Grid Height="62" Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="16"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <SymbolIcon Symbol="Play" Foreground="White" />
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                Text="{x:Bind Station.Name}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Text="{x:Bind Station.SummaryLine}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Opacity="0.7"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Button>

                <ToggleButton
                    Grid.Column="1"
                    Tag="{x:Bind}"
                    IsChecked="{x:Bind IsInLibrary, Mode=OneWay}"
                    Click="Star_Click"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Save to My Library">
                    <SymbolIcon Symbol="Favorite" />
                </ToggleButton>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- The inner Grid enforces the UniformGridLayout's minimum item size
             even when the window is squeezed below it. Without this, the
             ItemsRepeater is measured at a near-zero width during a resize,
             which can take down the whole XAML layout engine (the reported
             "resize to small size -> app exits" crash). -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="260" MinHeight="76">
                <ItemsRepeater
                    x:Name="Repeater"
                    ItemsSource="{x:Bind Items, Mode=OneWay}"
                    ItemTemplate="{StaticResource StationCardTemplate}"
                    HorizontalAlignment="Stretch">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="260"
                        MinItemHeight="76"
                        ItemsStretch="Fill"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock
            Text="{x:Bind EmptyText, Mode=OneWay}"
            Style="{ThemeResource BodyTextBlockStyle}"
            Opacity="0.6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            TextAlignment="Center"
            MaxWidth="360"
            Visibility="{x:Bind ShowEmptyState, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

        <!-- Loading state -->
        <ProgressRing
            IsActive="{x:Bind IsLoading, Mode=OneWay}"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
