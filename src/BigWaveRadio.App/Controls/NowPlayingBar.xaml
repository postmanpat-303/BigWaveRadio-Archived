<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BigWaveRadio.App.Controls.NowPlayingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BigWaveRadio.App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0"
        Padding="16,8"
        MinHeight="72">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Current station -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,0,16,0">
            <TextBlock
                Text="{Binding CurrentStation.Name, FallbackValue='Pick a station to start listening'}"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Text="{Binding Status}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Opacity="0.7" />
                <TextBlock
                    Text="{Binding CurrentStation.QualityLine, FallbackValue=''}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Opacity="0.7" />
            </StackPanel>
        </StackPanel>

        <!-- Transport -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ToggleButton
                IsChecked="{Binding IsPlaying, Mode=OneWay}"
                Command="{Binding TogglePlayPauseCommand}"
                IsEnabled="{Binding HasStation}"
               
                ToolTipService.ToolTip="Play / pause"
                MinWidth="40">
                <Grid>
                    <SymbolIcon Symbol="Play"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <SymbolIcon Symbol="Pause"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </ToggleButton>
            <Button
                Command="{Binding StopCommand}"
                IsEnabled="{Binding HasStation}"
               
                ToolTipService.ToolTip="Stop"
                MinWidth="40">
                <SymbolIcon Symbol="Stop" />
            </Button>
        </StackPanel>

        <!-- Volume -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
            <SymbolIcon Symbol="Volume" VerticalAlignment="Center" />
            <Slider
                Value="{Binding Volume, Mode=TwoWay}"
                Minimum="0"
                Maximum="1"
                StepFrequency="0.01"
                Width="130"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- Sleep timer -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0">
            <Button
                x:Name="SleepButton"
               
                ToolTipService.ToolTip="Sleep timer"
                MinWidth="40">
                <SymbolIcon Symbol="Clock" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="15 minutes" Tag="15" Click="SleepItem_Click" />
                        <MenuFlyoutItem Text="30 minutes" Tag="30" Click="SleepItem_Click" />
                        <MenuFlyoutItem Text="60 minutes" Tag="60" Click="SleepItem_Click" />
                        <MenuFlyoutItem Text="Off" Click="SleepOff_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock
                Text="{Binding SleepRemainingText}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.7"
                VerticalAlignment="Center"
                Visibility="{Binding SleepTimerActive, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Save current station -->
        <ToggleButton
            Grid.Column="4"
            IsChecked="{Binding CurrentStationInLibrary, Mode=OneWay}"
            Command="{Binding ToggleCurrentLibraryCommand}"
            IsEnabled="{Binding HasStation}"
            Background="Transparent"
            BorderThickness="0"
            ToolTipService.ToolTip="Save to My Library"
            VerticalAlignment="Center">
            <SymbolIcon Symbol="Favorite" />
        </ToggleButton>
    </Grid>
</UserControl>
